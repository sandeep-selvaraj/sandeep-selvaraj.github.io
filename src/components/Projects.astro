---
interface Project {
  name: string;
  description: string;
  url: string;
  page?: string;
  language: string;
  tags: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="section" id="projects">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title display">Projects</h2>
    </div>

    <div class="garage">
      {projects.map(p => (
        <article class="machine">
          <div>
            <h3 class="machine__name display">{p.name}</h3>
            {p.language && <span class="machine__lang">{p.language}</span>}
          </div>
          <div>
            <p class="machine__desc">{p.description}</p>
            {p.tags && p.tags.length > 0 && (
              <div class="pills machine__tags">{p.tags.map(t => <span class="pill">{t}</span>)}</div>
            )}
            <div class="machine__links">
              {p.page && <a class="textlink" href={p.page} target="_blank" rel="noopener">Project page</a>}
              {p.url && <a class="textlink" href={p.url} target="_blank" rel="noopener">Source on GitHub</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
