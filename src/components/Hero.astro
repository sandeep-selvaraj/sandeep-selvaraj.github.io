---
interface Props {
  greeting: string;
  name: string;
  surname: string;
  tagline: string;
}

const { greeting, name, surname, tagline } = Astro.props;
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero__inner">
      <div class="hero__aside hero__animate">{greeting}</div>
      <div class="hero__main">
        <h1 class="hero__name">
          <span class="hero__animate" style="--delay: 0.05s">{name}</span>
          <span class="hero__animate accent" style="--delay: 0.15s">{surname}</span>
        </h1>
        <div class="hero__rule hero__animate" style="--delay: 0.25s"></div>
        {tagline && (
          <p class="hero__tagline hero__animate" style="--delay: 0.3s">
            <span class="field">{tagline}</span>
          </p>
        )}
      </div>
    </div>
  </div>
</section>
