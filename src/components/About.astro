---
interface Props {
  headline: string;
  paragraphs: string[];
  tags: string[];
  location?: string;
  ethnicity?: string;
}

const { headline, paragraphs, tags, location, ethnicity } = Astro.props;
---

<section class="section" id="about">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title display">About</h2>
    </div>

    <div class="profile">
      <div>
        <p class="profile__headline">{headline}</p>
        <div class="prose">
          {paragraphs.map(p => <p>{p}</p>)}
        </div>
      </div>

      <dl class="spec">
        <div class="spec__row">
          <dt>Based in</dt>
          <dd>{location || 'Dresden, Germany'}</dd>
        </div>
        {ethnicity && (
          <div class="spec__row">
            <dt>Roots</dt>
            <dd>{ethnicity}</dd>
          </div>
        )}
        <div class="spec__row">
          <dt>Role</dt>
          <dd>Machine Learning Engineer</dd>
        </div>
        <div class="spec__row">
          <dt>Off track</dt>
          <dd>F1 (a Tifosi), football, the gym, guitar (still learning), robotics.</dd>
        </div>
        {tags.length > 0 && (
          <div class="spec__row">
            <dt>Focus</dt>
            <dd class="pills">{tags.map(t => <span class="pill">{t}</span>)}</dd>
          </div>
        )}
      </dl>
    </div>
  </div>
</section>
