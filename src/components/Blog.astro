---
interface BlogPost {
  title: string;
  category: string;
  excerpt: string;
  body: string[];
  date: string;
  readTime: string;
}

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

// A post whose body is still a placeholder is shown as in progress, not as a link to nothing
const isDraft = (p: BlogPost) => !p.body?.length || /\b(wip|coming soon)\b/i.test(p.body.join(' '));
const fmtDate = (d: string) => {
  const m = d.match(/^(\d{2})-(\d{2})-(\d{4})$/);
  if (!m) return d;
  const date = new Date(Date.UTC(+m[3], +m[2] - 1, +m[1]));
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
};
---

<section class="section" id="writing">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title display">Writing</h2>
    </div>

    <div class="notes">
      {posts.map(post => {
        const draft = isDraft(post);
        return (
          <article class="note">
            <div class="note__meta">
              <span>{fmtDate(post.date)}</span>
              <span>{post.category}</span>
            </div>
            <div>
              <h3 class="note__title display">{post.title}</h3>
              <p class="note__excerpt">{post.excerpt}</p>
              {draft ? (
                <span class="status status--wip">In progress</span>
              ) : (
                <>
                  <div class="note__body">
                    <div>{post.body.map(p => <p>{p}</p>)}</div>
                  </div>
                  <button class="note__toggle" type="button" aria-expanded="false">Read it · {post.readTime}</button>
                </>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.note__toggle').forEach(btn => {
    const label = btn.textContent;
    btn.addEventListener('click', () => {
      const body = btn.previousElementSibling as HTMLElement;
      const open = body.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Close' : label;
    });
  });
</script>
