---
interface BlogPost {
  title: string;
  category: string;
  excerpt: string;
  body: string[];
  date: string;
  readTime: string;
}

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const categories = [...new Set(posts.map(p => p.category))];
---

<section class="section" id="blog">
  <div class="container">
    <div class="slab">
      <div class="slab__label reveal">writing</div>
      <div class="slab__body">
        {posts.length > 0 && (
          <div class="blog__filters reveal">
            <button class="blog__filter active" data-filter="all">All</button>
            {categories.map(c => (
              <button class="blog__filter" data-filter={c}>
                {c.charAt(0).toUpperCase() + c.slice(1)}
              </button>
            ))}
          </div>
        )}

        {posts.map(post => (
          <article class="post reveal" data-category={post.category}>
            <div class="post__meta">
              <time>{post.date}</time>
              <span>{post.readTime}</span>
            </div>
            <div>
              <div class="post__cat">{post.category}</div>
              <h3 class="post__title">{post.title}</h3>
              <p class="post__excerpt">{post.excerpt}</p>
              {(post.body && post.body.length > 0) && (
                <>
                  <div class="post__expanded">
                    <div>
                      {post.body.map(p => <p>{p}</p>)}
                    </div>
                  </div>
                  <button class="post__toggle" aria-expanded="false">Read more</button>
                </>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.blog__filter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.blog__filter').forEach(f => f.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter;
      document.querySelectorAll('.post').forEach(card => {
        const el = card as HTMLElement;
        const show = filter === 'all' || el.dataset.category === filter;
        el.classList.toggle('hidden', !show);
      });
    });
  });

  document.querySelectorAll('.post__toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = (btn as HTMLElement).previousElementSibling as HTMLElement;
      const open = panel.classList.toggle('open');
      btn.textContent = open ? 'Read less' : 'Read more';
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
