---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sandeep Selvaraj, Machine Learning Engineer in Dresden. From Bangalore, ships ML end to end: models, pipelines and services.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#121316">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary">
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      try {
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && !sessionStorage.getItem('sel-launched')) {
          d.classList.add('prelaunch');
          // Failsafe: never hold the grid if the launch script does not run
          setTimeout(function () { d.classList.remove('prelaunch'); }, 4500);
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preload" href="/fonts/saira-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/saira-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="skip" href="#about">Skip to content</a>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
